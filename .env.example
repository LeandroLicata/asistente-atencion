# --- Cliente: config de la app web de Firebase ---
# (Consola → Configuración del proyecto → Tus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Servidor: secretos, nunca con prefijo NEXT_PUBLIC_ ---
# Service account (Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada). Copiar del JSON: project_id, client_email y
# private_key (entre comillas, con los \n tal cual vienen).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcionales: modelo y nivel de razonamiento de Gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=MINIMAL

# --- Cuenta demo (opcional) ---
# Si están, el login muestra "Probar con la cuenta demo". Son públicas a
# propósito. `npm run seed:demo` crea el usuario y conversaciones de ejemplo.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# --- WhatsApp Cloud API (opcional) ---
# Meta for Developers → tu app → WhatsApp → API Setup / Configuración.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → App secret. Se usa para verificar la firma de Meta.
WHATSAPP_APP_SECRET=
# Un texto que inventás vos y pegás también en la configuración del webhook.
WHATSAPP_VERIFY_TOKEN=
# uid de Firebase Auth de la cuenta que ve las conversaciones de WhatsApp en
# el panel (por ejemplo, la cuenta demo).
WHATSAPP_OWNER_UID=
# Opcional: versión de la Graph API (por defecto v26.0)
# WHATSAPP_API_VERSION=
